<script>
const YEARS = [2025,2024,2023,2022];
const STATES = ['Alabama','Alaska','Arizona','Arkansas','California','Colorado','Connecticut','Delaware','Florida','Georgia','Hawaii','Idaho','Illinois','Indiana','Iowa','Kansas','Kentucky','Louisiana','Maine','Maryland','Massachusetts','Michigan','Minnesota','Mississippi','Missouri','Montana','Nebraska','Nevada','New Hampshire','New Jersey','New Mexico','New York','North Carolina','North Dakota','Ohio','Oklahoma','Oregon','Pennsylvania','Rhode Island','South Carolina','South Dakota','Tennessee','Texas','Utah','Vermont','Virginia','Washington','West Virginia','Wisconsin','Wyoming'];

// ── VIEW SWITCHER ──
function switchView(v, btn){
  document.querySelectorAll('.view').forEach(el=>el.classList.remove('active'));
  document.querySelectorAll('.sw-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('view-'+v).classList.add('active');
  btn.classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}

// ── CLIENT NAVIGATION ──
function clientGo(n){
  document.querySelectorAll('.client-screen').forEach(s=>s.classList.remove('active'));
  const screens = ['cs0','cs1','cs2','cs3','cs4'];
  document.getElementById(screens[n]).classList.add('active');
  document.querySelectorAll('.cp-tab').forEach((t,i)=>{
    t.classList.remove('active','done');
    const num = t.querySelector('.cp-num');
    if(i===n){t.classList.add('active');num.textContent=i+1;}
    else if(i<n){t.classList.add('done');num.textContent='✓';}
    else num.textContent=i+1;
  });
  window.scrollTo({top:52,behavior:'smooth'});
}

// ── TRUE BINARY PATH — each path replaces screen 2 entirely ──
function goUploadPath(){
  // Hide ALL screens, show upload screen only
  document.querySelectorAll('.client-screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('cs2u').classList.add('active');
  // Update progress bar to show step 3
  document.querySelectorAll('.cp-tab').forEach((t,i)=>{
    t.classList.remove('active','done');
    const num = t.querySelector('.cp-num');
    if(i===2){t.classList.add('active');num.textContent=3;}
    else if(i<2){t.classList.add('done');num.textContent='✓';}
    else num.textContent=i+1;
  });
  window.scrollTo({top:52,behavior:'smooth'});
}

function goManualPath(){
  document.querySelectorAll('.client-screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('cs2m').classList.add('active');
  document.querySelectorAll('.cp-tab').forEach((t,i)=>{
    t.classList.remove('active','done');
    const num = t.querySelector('.cp-num');
    if(i===2){t.classList.add('active');num.textContent=3;}
    else if(i<2){t.classList.add('done');num.textContent='✓';}
    else num.textContent=i+1;
  });
  buildQRE('qreTableManual');
  window.scrollTo({top:52,behavior:'smooth'});
}

// ── UPLOAD SIMULATION ──
let uploadedCats = {};
function simulateUpload(cat){
  uploadedCats[cat] = true;
  const card = document.getElementById('ucat-'+cat);
  card.classList.add('done');
  // Check if at least one cat uploaded → trigger extraction
  const total = Object.keys(uploadedCats).length;
  if(total === 1){
    setTimeout(runExtraction, 500);
  }
}

async function runExtraction(){
  const card = document.getElementById('extractCard');
  card.classList.add('show');
  card.scrollIntoView({behavior:'smooth',block:'center'});

  const stepDefs = [
    {label:'Reading uploaded files', icon:'📄'},
    {label:'Identifying employees & contractors', icon:'👥'},
    {label:'Extracting wages and hours', icon:'💵'},
    {label:'Calculating qualified amounts', icon:'🧮'},
    {label:'Preparing your review form', icon:'✅'},
  ];
  const stepsEl = document.getElementById('extractSteps');
  stepsEl.innerHTML = stepDefs.map((_,i)=>`
    <div class="ex-step" id="xs${i}">
      <span class="ex-icon" id="xi${i}">${stepDefs[i].icon}</span>
      ${stepDefs[i].label}
    </div>`).join('');

  const bar = document.getElementById('extractBar');
  for(let i=0;i<stepDefs.length;i++){
    const row = document.getElementById('xs'+i);
    const ico = document.getElementById('xi'+i);
    row.classList.add('run');
    ico.outerHTML = `<div class="spin" id="xi${i}"></div>`;
    bar.style.width = ((i+0.5)/stepDefs.length*100)+'%';
    await sleep(i===0?1000:1600);
    document.getElementById('xs'+i).classList.remove('run');
    document.getElementById('xs'+i).classList.add('done');
    document.getElementById('xi'+i).outerHTML = `<span class="ex-icon" id="xi${i}">✓</span>`;
    bar.style.width = ((i+1)/stepDefs.length*100)+'%';
  }
  await sleep(400);
  card.style.display='none';
  const doneNote = document.getElementById('extractDone');
  doneNote.classList.add('show');
  // Show QRE table with pre-filled data
  const qreWrap = document.getElementById('qreAfterExtract');
  qreWrap.style.display='block';
  buildQRE('qreTableUpload');
  // Pre-fill 2025 with extracted data
  setTimeout(()=>{
    addEmpRow('qreTableUpload',2025,{name:'Brandon Carr',type:'Employee',state:'Georgia',wages:16025,totalHrs:1520,pct:40,project:'Digitization R&D'});
    addEmpRow('qreTableUpload',2025,{name:'Maddie Bell',type:'Employee',state:'Georgia',wages:6360,totalHrs:1500,pct:20,project:'Digitization R&D'});
    addEmpRow('qreTableUpload',2025,{name:'Mary Ashley Goodman',type:'Employee',state:'Georgia',wages:45000,totalHrs:2080,pct:50,project:'Digitization R&D'});
    addSupRow('qreTableUpload',2025,{desc:'Digitize files — paper to digital',project:'Digitization R&D',amount:9172});
  },200);
}

// ── BUILD QRE TABLE ──
function buildQRE(cid){
  const c = document.getElementById(cid);
  if(!c) return;
  c.innerHTML = YEARS.map(y=>`
    <div class="year-block">
      <div class="yb-head" onclick="toggleYear('${cid}',${y},this)">
        <div class="yb-label">${y}</div>
        <div class="yb-right">
          <div>
            <div class="yb-total-lbl">Qualified Research Expenses</div>
            <div class="yb-total-val" id="${cid}_tot_${y}">$0</div>
          </div>
          <div class="yb-toggle" id="${cid}_tgl_${y}">${y===2025?'▲':'▼'}</div>
        </div>
      </div>
      <div class="yb-body${y!==2025?' collapsed':''}" id="${cid}_body_${y}">
        <table class="qt">
          <thead><tr>
            <th>Name</th>
            <th>Type</th>
            <th>State</th>
            <th>Total Wages</th>
            <th>Total Hrs Worked</th>
            <th>% Time on R&D</th>
            <th>R&D Hours <span class="calc-badge">auto</span></th>
            <th style="text-align:right">Qualified Amt <span class="calc-badge">auto</span></th>
            <th>Project</th>
            <th></th>
          </tr></thead>
          <tbody id="${cid}_emp_${y}"></tbody>
        </table>
        <button class="add-row-btn" onclick="addEmpRow('${cid}',${y})">+ Add Person</button>
        <div class="sup-divider">Supplies &amp; Materials <span style="font-weight:300;text-transform:none;letter-spacing:0;font-size:10px;color:var(--muted);">— optional</span></div>
        <table class="qt">
          <thead><tr><th>Description</th><th>R&D Project</th><th style="text-align:right">Amount</th><th></th></tr></thead>
          <tbody id="${cid}_sup_${y}"></tbody>
        </table>
        <button class="add-row-btn" onclick="addSupRow('${cid}',${y})">+ Add Expense</button>
      </div>
    </div>`).join('');
}

function toggleYear(cid, y, hdr){
  const body = document.getElementById(`${cid}_body_${y}`);
  const tgl = document.getElementById(`${cid}_tgl_${y}`);
  const collapsed = body.classList.toggle('collapsed');
  tgl.textContent = collapsed ? '▼' : '▲';
  hdr.classList.toggle('collapsed', collapsed);
}

// ── ADD ROWS ──
function addEmpRow(cid, year, pre={}){
  const tbody = document.getElementById(`${cid}_emp_${year}`);
  if(!tbody) return;
  const id = `e_${cid}_${year}_${uid()}`;
  const stOpts = STATES.map(s=>`<option${pre.state===s?' selected':''}>${s}</option>`).join('');
  const tr = document.createElement('tr');
  tr.id = id;
  tr.innerHTML = `
    <td><input type="text" value="${pre.name||''}" placeholder="Full name" oninput="recalc('${cid}',${year})"></td>
    <td><select onchange="recalc('${cid}',${year})">
      <option${pre.type==='Employee'?' selected':''}>Employee</option>
      <option${pre.type==='Contractor'?' selected':''}>Contractor</option>
    </select></td>
    <td><select onchange="recalc('${cid}',${year})"><option value="">State</option>${stOpts}</select></td>
    <td><input type="number" value="${pre.wages||''}" placeholder="0" min="0" oninput="recalc('${cid}',${year})" style="text-align:right"></td>
    <td><input type="number" value="${pre.totalHrs||''}" placeholder="e.g. 2080" min="0" oninput="recalc('${cid}',${year})" style="text-align:right" id="th_${id}"></td>
    <td>
      <div style="position:relative">
        <input type="number" value="${pre.pct||''}" placeholder="0" min="0" max="100" oninput="recalc('${cid}',${year})" style="text-align:right;padding-right:26px;" id="pct_${id}">
        <span style="position:absolute;right:9px;top:50%;transform:translateY(-50%);font-size:11px;color:var(--muted);pointer-events:none;">%</span>
      </div>
    </td>
    <td><input type="number" readonly id="rdh_${id}" placeholder="—" style="text-align:right;min-width:80px;"></td>
    <td class="qv-cell"><span class="qv empty" id="qv_${id}">—</span></td>
    <td><input type="text" value="${pre.project||''}" placeholder="R&D activity name"></td>
    <td><button class="del-btn" onclick="delRow('${id}','${cid}',${year})">×</button></td>
  `;
  tbody.appendChild(tr);
  recalc(cid, year);
}

function addSupRow(cid, year, pre={}){
  const tbody = document.getElementById(`${cid}_sup_${year}`);
  if(!tbody) return;
  const id = `s_${cid}_${year}_${uid()}`;
  const tr = document.createElement('tr');
  tr.id = id;
  tr.innerHTML = `
    <td><input type="text" value="${pre.desc||''}" placeholder="Expense description"></td>
    <td><input type="text" value="${pre.project||''}" placeholder="R&D project"></td>
    <td><input type="number" value="${pre.amount||''}" placeholder="0" min="0" oninput="recalc('${cid}',${year})" style="text-align:right"></td>
    <td><button class="del-btn" onclick="delRow('${id}','${cid}',${year})">×</button></td>
  `;
  tbody.appendChild(tr);
  recalc(cid, year);
}

function delRow(id, cid, year){
  document.getElementById(id)?.remove();
  recalc(cid, year);
}

// ── RECALCULATE ──
// Per employee: R&D Hours = Total Hrs × (% ÷ 100)  [OUTPUT]
//               Qualified Amount = Wages × (% ÷ 100) [OUTPUT]
function recalc(cid, year){
  let empTotal = 0, supTotal = 0;
  document.querySelectorAll(`#${cid}_emp_${year} tr`).forEach(tr=>{
    const numInputs = tr.querySelectorAll('input[type=number]');
    const wages      = parseFloat(numInputs[0]?.value)||0; // Total Wages
    const totalHrs   = parseFloat(numInputs[1]?.value)||0; // Total Hours Worked
    const pct        = parseFloat(numInputs[2]?.value)||0; // % R&D Time
    // Outputs
    const rdHours    = totalHrs * (pct/100);
    const qualified  = wages * (pct/100);
    // Write R&D hours (readonly field)
    const rdhField = numInputs[3];
    if(rdhField){
      rdhField.value = (totalHrs && pct) ? Math.round(rdHours) : '';
      rdhField.placeholder = (totalHrs && pct) ? '' : '—';
    }
    // Write qualified amount
    const qvEl = tr.querySelector('[id^="qv_"]');
    if(qvEl){
      if(wages && pct){qvEl.textContent=fmt(qualified);qvEl.classList.remove('empty');}
      else{qvEl.textContent='—';qvEl.classList.add('empty');}
    }
    empTotal += qualified;
  });
  document.querySelectorAll(`#${cid}_sup_${year} tr`).forEach(tr=>{
    const ins = tr.querySelectorAll('input[type=number]');
    supTotal += parseFloat(ins[0]?.value)||0;
  });
  const totEl = document.getElementById(`${cid}_tot_${year}`);
  if(totEl) totEl.textContent = fmt(empTotal+supTotal);
}

// ── ADMIN NAVIGATION ──
function adminGo(screen, el){
  document.querySelectorAll('.admin-screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('as-'+screen).classList.add('active');
  document.querySelectorAll('.sb-link').forEach(l=>l.classList.remove('active'));
  if(el) el.classList.add('active');
}

// ── MODAL ──
function showModal(){document.getElementById('modal').classList.add('open');}
function hideModal(){document.getElementById('modal').classList.remove('open');}
function maybeClose(e){if(e.target.id==='modal')hideModal();}

// ── UTILS ──
function fmt(n){if(!n)return'$0';return'$'+Math.round(n).toLocaleString();}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,5);}
function sleep(ms){return new Promise(r=>setTimeout(r,ms));}
