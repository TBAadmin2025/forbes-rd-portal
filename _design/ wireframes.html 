<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Forbes Management — System Wireframes V2</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@200;300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --cherry:    #6C161C;
  --cherry-dk: #4A0F13;
  --cherry-md: #8B1D24;
  --champagne: #E2C49B;
  --champ-dk:  #C4A27A;
  --ivory:     #F0E7D7;
  --ivory-dk:  #E4D9C6;
  --charcoal:  #111111;
  --charcoal2: #1C1C1C;
  --emerald:   #004F35;
  --em-light:  #EEF6F1;
  --muted:     #7A7060;
  --border:    rgba(108,22,28,0.12);
  --white:     #FFFFFF;
  --warm:      #FAF7F2;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'Montserrat',sans-serif;background:#1a1a1a;color:var(--charcoal);-webkit-font-smoothing:antialiased;}

/* ── SWITCHER ── */
.switcher{
  position:fixed;top:0;left:0;right:0;z-index:9999;
  background:var(--charcoal);
  display:flex;align-items:center;
  padding:0 32px;height:52px;gap:6px;
  border-bottom:1px solid rgba(255,255,255,0.06);
}
.sw-label{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.22);margin-right:12px;white-space:nowrap;}
.sw-btn{
  padding:7px 20px;border-radius:100px;
  font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;
  border:1.5px solid rgba(255,255,255,0.1);
  background:transparent;color:rgba(255,255,255,0.3);
  cursor:pointer;transition:all 0.2s;white-space:nowrap;
}
.sw-btn:hover{border-color:var(--champagne);color:var(--champagne);}
.sw-btn.active{background:var(--cherry);border-color:var(--cherry);color:var(--ivory);}
.sw-right{margin-left:auto;font-size:10px;color:rgba(255,255,255,0.15);letter-spacing:1px;}

/* ── VIEWS ── */
.view{display:none;min-height:100vh;padding-top:52px;}
.view.active{display:block;}

/* ── FM PATTERN ── */
.fm-pat{
  background-image:url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M40 0l40 40-40 40L0 40z' fill='none' stroke='%23E2C49B' stroke-opacity='0.18' stroke-width='0.5'/%3E%3Ctext x='40' y='46' font-family='Playfair Display,serif' font-size='14' fill='%23E2C49B' text-anchor='middle' opacity='0.2' font-style='italic'%3EFM%3C/text%3E%3C/svg%3E");
}

/* ── SHARED HEADER ── */
.site-header{
  background:var(--cherry);height:64px;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 48px;position:relative;overflow:hidden;
}
.site-header .fm-pat{position:absolute;inset:0;opacity:0.35;pointer-events:none;}
.site-header-inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;width:100%;}
.logo-block{display:flex;flex-direction:column;gap:3px;}
.logo-img{height:38px;width:auto;display:block;}
.logo-sub{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--champagne);font-weight:500;padding-left:2px;}
.header-right{display:flex;align-items:center;gap:16px;}
.avatar{width:32px;height:32px;border-radius:50%;background:var(--cherry-md);border:1.5px solid rgba(226,196,155,0.4);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:var(--champagne);}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 24px;border:none;border-radius:3px;font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:all 0.2s;text-decoration:none;white-space:nowrap;}
.btn-cherry{background:var(--cherry);color:var(--ivory);}
.btn-cherry:hover{background:var(--cherry-md);}
.btn-champagne{background:var(--champagne);color:var(--charcoal);}
.btn-champagne:hover{background:var(--champ-dk);}
.btn-ghost{background:transparent;color:var(--charcoal);border:1.5px solid var(--border);}
.btn-ghost:hover{border-color:var(--cherry);color:var(--cherry);}
.btn-dark{background:var(--charcoal);color:var(--ivory);}
.btn-dark:hover{background:var(--cherry);}
.btn-em{background:var(--emerald);color:var(--white);}
.btn-em:hover{background:#006647;}
.btn-sm{padding:7px 16px;font-size:10px;}
.btn-lg{padding:14px 32px;font-size:12px;}

/* ── CARDS ── */
.card{background:var(--white);border:1px solid var(--border);border-radius:4px;padding:28px;margin-bottom:20px;}
.card-title{font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:var(--charcoal);margin-bottom:4px;}
.card-sub{font-size:12px;color:var(--muted);font-weight:300;margin-bottom:20px;line-height:1.6;}

/* ── FORMS ── */
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
.form-row.three{grid-template-columns:1fr 1fr 1fr;}
.ff{margin-bottom:16px;}
.flabel{display:block;font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
.fhint{font-size:11px;color:var(--muted);margin-top:4px;font-weight:300;font-style:italic;}
.finput{width:100%;padding:11px 14px;border:1.5px solid rgba(108,22,28,0.15);background:var(--warm);font-family:'Montserrat',sans-serif;font-size:13px;color:var(--charcoal);border-radius:3px;outline:none;transition:border-color 0.2s;-webkit-appearance:none;}
.finput:focus{border-color:var(--cherry);background:var(--white);}
.finput::placeholder{color:#c4bdb4;}
.finput[readonly]{background:#f5f0e8;color:var(--emerald);font-weight:600;border-color:rgba(0,79,53,0.2);}

/* ── TAGS ── */
.tag{display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:100px;font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;}
.tag-invited{background:rgba(226,196,155,0.2);color:var(--champ-dk);}
.tag-progress{background:rgba(0,79,53,0.1);color:var(--emerald);}
.tag-submitted{background:rgba(108,22,28,0.1);color:var(--cherry);}
.tag-complete{background:var(--charcoal);color:var(--champagne);}

/* ── INFO BOX ── */
.info-box{background:#fdf8f0;border-left:3px solid var(--champagne);padding:13px 17px;font-size:12px;line-height:1.7;border-radius:0 3px 3px 0;margin-bottom:20px;color:var(--charcoal);font-weight:300;}
.info-box strong{font-weight:600;color:var(--cherry);}

.nav-row{display:flex;align-items:center;justify-content:space-between;margin-top:32px;padding-top:24px;border-top:1px solid var(--border);}

@keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}


/* ══════════════════════════════════════════
   CLIENT PORTAL
══════════════════════════════════════════ */
#view-client{background:var(--ivory);}

.client-progress{
  background:var(--charcoal2);display:flex;padding:0 48px;
  border-bottom:1px solid rgba(255,255,255,0.05);overflow-x:auto;
}
.cp-tab{
  padding:14px 22px;font-size:10px;letter-spacing:2px;text-transform:uppercase;font-weight:600;
  color:rgba(255,255,255,0.22);border-bottom:2px solid transparent;
  cursor:pointer;transition:all 0.2s;display:flex;align-items:center;gap:8px;white-space:nowrap;
}
.cp-tab.active{color:var(--champagne);border-bottom-color:var(--champagne);}
.cp-tab.done{color:var(--emerald);border-bottom-color:var(--emerald);}
.cp-num{width:18px;height:18px;border-radius:50%;background:rgba(255,255,255,0.07);display:flex;align-items:center;justify-content:center;font-size:9px;}
.cp-tab.active .cp-num{background:var(--champagne);color:var(--charcoal);}
.cp-tab.done .cp-num{background:var(--emerald);color:var(--white);}

.client-main{max-width:860px;margin:0 auto;padding:44px 28px 80px;}
.client-screen{display:none;}
.client-screen.active{display:block;animation:fadeUp 0.3s ease;}

/* ── WELCOME ── */
.welcome-hero{
  background:var(--cherry);border-radius:6px;padding:52px 48px;
  position:relative;overflow:hidden;margin-bottom:24px;
}
.welcome-hero .fm-pat{position:absolute;inset:0;opacity:0.3;pointer-events:none;}
.welcome-hero-inner{position:relative;z-index:1;}
.w-eyebrow{font-size:10px;letter-spacing:4px;text-transform:uppercase;color:var(--champagne);margin-bottom:16px;font-weight:500;display:flex;align-items:center;gap:10px;}
.w-eyebrow::before{content:'';width:20px;height:1px;background:var(--champagne);}
.welcome-hero h1{font-family:'Playfair Display',serif;font-size:clamp(32px,4vw,52px);font-weight:700;color:var(--ivory);line-height:1.1;margin-bottom:14px;}
.welcome-hero h1 em{font-style:italic;color:var(--champagne);}
.welcome-hero p{font-size:14px;color:rgba(240,231,215,0.62);font-weight:300;line-height:1.85;max-width:480px;margin-bottom:28px;}
.welcome-steps{display:flex;gap:0;max-width:520px;margin-bottom:32px;border:1px solid rgba(240,231,215,0.12);border-radius:3px;overflow:hidden;}
.ws{flex:1;padding:16px 12px;background:rgba(240,231,215,0.05);border-right:1px solid rgba(240,231,215,0.1);text-align:center;}
.ws:last-child{border-right:none;}
.ws-num{font-family:'Playfair Display',serif;font-size:26px;color:var(--champagne);font-weight:700;}
.ws-lbl{font-size:10px;color:rgba(240,231,215,0.45);margin-top:4px;letter-spacing:1px;}

/* ── PATH PICKER — TRUE BINARY ── */
.path-section{margin-bottom:28px;}
.path-section-title{font-family:'Playfair Display',serif;font-size:26px;font-weight:700;color:var(--charcoal);margin-bottom:6px;}
.path-section-sub{font-size:13px;color:var(--muted);font-weight:300;margin-bottom:24px;line-height:1.6;}

.path-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.path-card{
  background:var(--white);border:2px solid var(--border);
  border-radius:4px;padding:36px 28px;cursor:pointer;
  transition:all 0.25s;position:relative;overflow:hidden;
}
.path-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--cherry);transform:scaleX(0);transform-origin:left;transition:transform 0.3s cubic-bezier(0.16,1,0.3,1);}
.path-card:hover::before{transform:scaleX(1);}
.path-card:hover{border-color:var(--cherry);transform:translateY(-2px);box-shadow:0 8px 32px rgba(108,22,28,0.1);}
.pc-icon{font-size:36px;margin-bottom:16px;display:block;}
.pc-title{font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:var(--charcoal);margin-bottom:8px;}
.pc-desc{font-size:12px;color:var(--muted);line-height:1.75;font-weight:300;margin-bottom:16px;}
.pc-pill{display:inline-block;padding:4px 12px;border-radius:100px;font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;}
.pc-pill-rec{background:rgba(0,79,53,0.08);color:var(--emerald);}
.pc-pill-alt{background:rgba(108,22,28,0.07);color:var(--cherry);}
.pc-action{
  display:flex;align-items:center;justify-content:center;
  margin-top:20px;padding:12px;
  background:var(--cherry);color:var(--ivory);
  border-radius:3px;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;
  transition:background 0.2s;
}
.path-card:hover .pc-action{background:var(--cherry-md);}
.pc-action-alt{background:var(--charcoal);}
.path-card:hover .pc-action-alt{background:var(--cherry);}

/* ── UPLOAD PATH ── */
.upload-path-view{animation:fadeUp 0.3s ease;}
.path-back{display:inline-flex;align-items:center;gap:6px;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;font-weight:600;color:var(--muted);cursor:pointer;transition:color 0.2s;margin-bottom:20px;}
.path-back:hover{color:var(--cherry);}

.upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;}
.upload-cat{
  background:var(--white);border:2px dashed rgba(108,22,28,0.2);
  border-radius:4px;padding:28px 20px;text-align:center;
  cursor:pointer;transition:all 0.2s;position:relative;
}
.upload-cat:hover{border-color:var(--cherry);border-style:solid;background:#fdf5ed;transform:translateY(-2px);}
.upload-cat.done{border-color:var(--emerald);border-style:solid;background:var(--em-light);}
.uc-icon{font-size:28px;margin-bottom:10px;}
.uc-title{font-family:'Playfair Display',serif;font-size:15px;font-weight:700;color:var(--charcoal);margin-bottom:5px;}
.uc-desc{font-size:11px;color:var(--muted);line-height:1.6;font-weight:300;}
.uc-years{font-size:10px;letter-spacing:1.5px;color:var(--champagne);font-weight:600;margin-top:8px;}
.uc-opt{display:inline-block;margin-top:6px;font-size:9px;letter-spacing:1px;text-transform:uppercase;font-weight:600;color:var(--muted);background:var(--ivory-dk);padding:2px 8px;border-radius:100px;}
.uc-done{font-size:11px;color:var(--emerald);font-weight:600;margin-top:8px;display:flex;align-items:center;justify-content:center;gap:5px;}
.uc-badge{position:absolute;top:10px;right:10px;background:var(--emerald);color:var(--white);width:20px;height:20px;border-radius:50%;display:none;align-items:center;justify-content:center;font-size:10px;font-weight:700;}
.upload-cat.done .uc-badge{display:flex;}

/* Extraction progress */
.extract-card{
  background:var(--charcoal);border-radius:4px;padding:36px;
  text-align:center;margin-bottom:20px;
  display:none;
}
.extract-card.show{display:block;animation:fadeUp 0.3s ease;}
.extract-title{font-family:'Playfair Display',serif;font-size:22px;color:var(--ivory);margin-bottom:6px;}
.extract-sub{font-size:12px;color:rgba(240,231,215,0.45);margin-bottom:28px;font-weight:300;}
.extract-steps{max-width:380px;margin:0 auto 24px;display:flex;flex-direction:column;gap:8px;text-align:left;}
.ex-step{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:3px;font-size:12px;color:rgba(240,231,215,0.4);background:rgba(255,255,255,0.03);transition:all 0.3s;}
.ex-step.run{color:var(--champagne);background:rgba(226,196,155,0.07);}
.ex-step.done{color:#4caf7d;background:rgba(76,175,125,0.07);}
.ex-icon{font-size:15px;width:20px;text-align:center;flex-shrink:0;}
.spin{width:15px;height:15px;border:2px solid rgba(226,196,155,0.2);border-top-color:var(--champagne);border-radius:50%;animation:spin 0.7s linear infinite;flex-shrink:0;}
@keyframes spin{to{transform:rotate(360deg);}}
.extract-bar-wrap{max-width:380px;margin:0 auto;height:3px;background:rgba(255,255,255,0.08);border-radius:2px;overflow:hidden;}
.extract-bar{height:100%;background:linear-gradient(90deg,var(--cherry),var(--champagne));border-radius:2px;width:0%;transition:width 0.5s ease;}

.extract-done-note{display:none;animation:fadeUp 0.3s ease;}
.extract-done-note.show{display:block;}

/* ── QRE TABLE ── */
.year-block{margin-bottom:20px;}
.yb-head{background:var(--charcoal);padding:13px 18px;border-radius:3px 3px 0 0;display:flex;align-items:center;justify-content:space-between;cursor:pointer;}
.yb-head.collapsed{border-radius:3px;}
.yb-label{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:var(--ivory);}
.yb-right{text-align:right;display:flex;align-items:center;gap:16px;}
.yb-total-lbl{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:rgba(240,231,215,0.35);}
.yb-total-val{font-size:18px;font-weight:600;color:var(--champagne);}
.yb-toggle{font-size:12px;color:rgba(240,231,215,0.3);transition:transform 0.2s;}
.yb-body{border:1px solid var(--border);border-top:none;border-radius:0 0 3px 3px;overflow:hidden;}

/* QRE table */
.qt{width:100%;border-collapse:collapse;font-size:12px;}
.qt th{background:#f5f0e8;font-size:9px;letter-spacing:1.2px;text-transform:uppercase;font-weight:600;color:var(--muted);padding:9px 10px;text-align:left;white-space:nowrap;}
.qt td{padding:8px 10px;border-bottom:1px solid #f0ebe0;background:var(--white);vertical-align:middle;}
.qt tr:last-child td{border-bottom:none;}
.qt tr:hover td{background:#fdf9f4;}
.qt input,.qt select{padding:6px 8px;font-size:12px;border:1.5px solid rgba(108,22,28,0.12);border-radius:2px;width:100%;background:var(--warm);font-family:'Montserrat',sans-serif;outline:none;}
.qt input:focus,.qt select:focus{border-color:var(--cherry);}
.qt input[readonly]{background:#f0f7f3;color:var(--emerald);font-weight:600;border-color:rgba(0,79,53,0.15);cursor:default;}
.calc-badge{font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--emerald);font-weight:600;display:block;margin-top:2px;opacity:0.7;}

.qv-cell{text-align:right;}
.qv{font-size:12px;font-weight:600;color:var(--emerald);background:rgba(0,79,53,0.07);padding:6px 10px;border-radius:2px;white-space:nowrap;display:inline-block;min-width:85px;text-align:right;}
.qv.empty{color:var(--muted);background:#f0ebe0;}

.add-row-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;margin:10px 12px;border:1.5px dashed rgba(108,22,28,0.2);background:transparent;border-radius:3px;font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);cursor:pointer;transition:all 0.2s;}
.add-row-btn:hover{border-color:var(--cherry);color:var(--cherry);background:#fdf5ed;}
.del-btn{background:none;border:none;color:#d0c8bc;cursor:pointer;font-size:16px;padding:2px 4px;transition:color 0.2s;line-height:1;}
.del-btn:hover{color:#c0392b;}
.sup-divider{font-size:10px;letter-spacing:2px;text-transform:uppercase;font-weight:600;color:var(--muted);padding:12px 12px 8px;background:#faf7f1;border-top:1px solid var(--border);}

/* year collapsed state */
.yb-body.collapsed{display:none;}

/* ── CREDIT SUMMARY ── */
.credit-summary{
  background:var(--charcoal);border-radius:4px;padding:36px;
  margin-bottom:20px;position:relative;overflow:hidden;
}
.credit-summary .fm-pat{position:absolute;inset:0;opacity:0.12;pointer-events:none;}
.credit-inner{position:relative;z-index:1;}
.credit-top{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-bottom:28px;padding-bottom:28px;border-bottom:1px solid rgba(240,231,215,0.08);}
.credit-metric-lbl{font-size:9px;letter-spacing:3px;text-transform:uppercase;color:rgba(240,231,215,0.35);margin-bottom:8px;}
.credit-metric-val{font-family:'Playfair Display',serif;font-size:44px;font-weight:700;color:var(--champagne);line-height:1;}
.credit-metric-sub{font-size:11px;color:rgba(240,231,215,0.3);margin-top:6px;font-weight:300;}
.credit-breakdown{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.cb-item{text-align:center;padding:16px;background:rgba(255,255,255,0.04);border-radius:3px;}
.cb-lbl{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:rgba(240,231,215,0.35);margin-bottom:6px;}
.cb-val{font-size:22px;font-weight:600;color:var(--champagne);}
.cb-method{font-size:10px;color:rgba(240,231,215,0.25);margin-top:4px;font-weight:300;}
.credit-note{font-size:11px;color:rgba(240,231,215,0.25);margin-top:20px;text-align:center;font-style:italic;font-weight:300;}

/* Year QRE summary table */
.yr-summary-table{width:100%;border-collapse:collapse;font-size:13px;}
.yr-summary-table th{background:#f0ebe0;font-size:9px;letter-spacing:1.5px;text-transform:uppercase;font-weight:600;color:var(--muted);padding:9px 14px;text-align:left;}
.yr-summary-table td{padding:11px 14px;border-bottom:1px solid var(--border);}
.yr-summary-table tr:last-child td{font-weight:600;background:#fdf9f0;border-bottom:none;}
.mono{font-weight:600;color:var(--emerald);}

/* Confirmation */
.confirm-hero{background:var(--charcoal);border-radius:4px;padding:40px;text-align:center;margin-bottom:20px;position:relative;overflow:hidden;}
.confirm-hero .fm-pat{position:absolute;inset:0;opacity:0.12;}
.confirm-hero-inner{position:relative;z-index:1;}
.confirm-icon{font-size:52px;margin-bottom:14px;}
.confirm-title{font-family:'Playfair Display',serif;font-size:34px;font-weight:700;color:var(--champagne);margin-bottom:8px;}
.confirm-sub{font-size:13px;color:rgba(240,231,215,0.5);font-weight:300;line-height:1.8;}
.confirm-tiles{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:20px;}
.ct{background:var(--white);border:1px solid var(--border);border-radius:3px;padding:18px;text-align:center;}
